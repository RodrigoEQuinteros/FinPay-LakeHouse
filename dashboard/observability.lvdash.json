            "expr": "source.details",
            "displayName": "Details"
          },
          {
            "name": "event_type",
            "expr": "source.event_type",
            "displayName": "Event Type"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "7d2c7bd9",
      "displayName": "fintech_finpay",
      "queryLines": [
        "SELECT \r\n",
        "    timestamp,\r\n",
        "    origin.pipeline_name AS pipeline,\r\n",
        "    level AS nivel_log,\r\n",
        "    message,\r\n",
        "    -- Aquí abrimos el paquete JSON para sacar las filas procesadas:\r\n",
        "    CAST(details:flow_progress.metrics.num_output_rows AS INT) AS filas_procesadas,\r\n",
        "    details:flow_progress.status AS estado_flujo\r\n",
        "FROM fintech_finpay.observability.finpay_event_log_dev\r\n",
        "WHERE details:flow_progress.status IS NOT NULL\r\n",
        "ORDER BY timestamp DESC;"
      ]
    }
  ],
